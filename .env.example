# ════════════════════════════════════════════════════════════════
# 部署环境变量模板：复制成 .env 后按需修改（.env 已在 .gitignore 中，不会入库）
#   cp .env.example .env && vi .env
# ════════════════════════════════════════════════════════════════

# ── 必填：不填应用直接启动失败（这是故意的，见 DEPLOY.md「为什么强制」）──
# JWT 签名密钥：一旦沿用源码里的默认值，任何看过仓库的人都能伪造管理员 token
# 生成：openssl rand -base64 48
JWT_SECRET=
# 数据库密码：compose 用它初始化 MySQL，应用用它连库
DB_PASSWORD=

# ── 数据库连接 ──
DB_HOST=mysql                 # compose 内部用服务名；连宿主机已有 MySQL 时改成 host.docker.internal
DB_PORT=3306
DB_NAME=volunteer_db
DB_USERNAME=root

# ── 应用 ──
SERVER_PORT=8081
# 上传根目录：容器内固定 /data/files，由 compose 映射到宿主机的 ./files
UPLOAD_DIR=/data/files
# 演示环境建议比开发更短（封禁/降权无法即时生效，缩短有效期能减少暴露窗口）
JWT_EXPIRE_HOURS=12

# ── 上传限额（默认 2MB / 4MB，生产别开太大，避免被人刷满磁盘）──
UPLOAD_MAX_SIZE=2MB
UPLOAD_MAX_REQUEST=4MB

# ── 日志 ──
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# ── 接口文档：/doc.html。演示时是亮点，不想公开就设 false ──
SWAGGER_ENABLED=true

# ── 前端容器对外端口（一般保持 80/443）──
HTTP_PORT=80
HTTPS_PORT=443
