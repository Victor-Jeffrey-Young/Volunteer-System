# ════════════════════════════════════════════════════════════════
# 前端镜像：Node 构建 Vite 产物 → nginx 托管（含 API 反向代理）
# 构建上下文是仓库根目录，构建命令由 docker-compose.yml 指定
# ════════════════════════════════════════════════════════════════

# ---------- 构建阶段 ----------
FROM node:22-alpine AS build
WORKDIR /app

COPY volunteer-web/package*.json ./
RUN npm ci

COPY volunteer-web/ ./
RUN npm run build

# ---------- 运行阶段 ----------
FROM nginx:1.27-alpine
ENV TZ=Asia/Shanghai

# 站点配置：HTTPS + SPA 深链兜底 + /api、/files 反代到后端
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# 前端产物
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80 443
